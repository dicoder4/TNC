# Copy to .env and fill in. See README for setup.
VITE_GCAL_API_KEY=
VITE_GCAL_CALENDAR_ID=
# Must match the Google Calendar's own timezone
VITE_GCAL_TIMEZONE=Asia/Kolkata
# Optional: TNC's WhatsApp number with country code (e.g. 919876543210).
# Adds a "Send on WhatsApp" button that pre-fills the enquiry.
VITE_WHATSAPP_NUMBER=
# Optional: Google Apps Script web app URL (ends in /exec). Emails TNC and logs
# every enquiry to a Google Sheet. See README "Enquiry emails".
VITE_ENQUIRY_URL=
